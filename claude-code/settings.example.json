{
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '<path-to-hooks>/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    }
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "autoCompactWindow": 272000,
  "tui": "fullscreen",
  "agentPushNotifEnabled": true
}
